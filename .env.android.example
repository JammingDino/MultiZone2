# The three variables `tauri android` needs on this machine (0.17.2).
#
# Copy to `.env.android` (gitignored) and source it, or set them in your shell
# profile. They are not in the repo because every one of them is a path that
# differs per machine.
#
#   export $(grep -v '^#' .env.android | xargs)   # bash
#
# Windows also needs **Developer Mode** on (Settings → System → For developers).
# Tauri symlinks the built `.so` into `jniLibs`, and Windows refuses symlinks
# without it — the build compiles the whole Rust crate and then fails at the
# last step, which reads like a toolchain problem and is a checkbox.
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-22.0.2.9-hotspot
ANDROID_HOME=C:\Users\<you>\AppData\Local\Android\Sdk
NDK_HOME=C:\Users\<you>\AppData\Local\Android\Sdk\ndk\27.1.12297006
